{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(git stash *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh api repos/*)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(uv run *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(make *)",
      "Bash(./scripts/verify.sh *)",
      "Bash(./scripts/verify.sh)",
      "Bash(./gradlew *)",
      "Bash(gradle *)",
      "Bash(./mvnw *)",
      "Bash(mvn *)",
      "Bash(go *)",
      "Bash(gofmt *)",
      "Bash(golangci-lint *)",
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(coverage *)",
      "Bash(./scripts/verify.sh --fast)",
      "Bash(./scripts/verify.sh --fix)",
      "Write(.claude/tmp/**)",
      "Edit(.claude/tmp/**)",
      "Write(.claude/agent-memory/**)",
      "Edit(.claude/agent-memory/**)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh issue close *)",
      "Bash(git merge *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fdx *)",
      "Bash(git filter-branch *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh release *)",
      "Bash(gh secret *)",
      "Bash(gh auth token *)",
      "Bash(gh workflow disable *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Edit(./.git/**)",
      "Edit(./.github/workflows/**)",
      "Edit(./gradlew)",
      "Edit(./gradle/wrapper/**)",
      "Bash(flutter channel *)",
      "Bash(flutter upgrade *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh",
            "timeout": 30,
            "statusMessage": "ループの状態を確認中..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh",
            "timeout": 15,
            "statusMessage": "危険操作をチェック中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-check.sh",
            "timeout": 120,
            "statusMessage": "変更ファイルを整形・検査中..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/audit-stop.sh",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ]
  }
}
