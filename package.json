{
  "name": "loop-practice",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "verify": "./scripts/verify.sh"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^4.1.0"
  }
}
